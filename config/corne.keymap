/*
 * Corne 42 LP Wireless - ZMK Keymap
 *
 * Layer 0: Base (QWERTY)
 * Layer 1: Navigation / Arrows
 * Layer 2: Numbers / Symbols
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/reset.h>

&led_strip {
    chain-length = <27>;
};

&lt {
    quick-tap-ms = <200>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BAS";
            bindings = <
                &kp ESC   &kp Q  &kp W  &kp E  &kp R  &kp T        &kp Y  &kp U  &kp I      &kp O    &kp P     &kp DEL
                &kp LALT  &kp A  &kp S  &kp D  &kp F  &kp G        &kp H  &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
                &kp LSHFT &kp Z  &kp X  &kp C  &kp V  &kp B        &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RCTRL
                              &kp LCTRL  &lt 1 RET  &lt 2 SPACE     &lt 2 BSPC  &lt 1 TAB  &kp LGUI
            >;
        };

        nav_layer {
            display-name = "NAV";
            bindings = <
                &none      &none  &none  &none  &none  &bt BT_CLR     &none        &kp C_VOL_DN &kp C_VOL_UP &kp LBRC  &kp RBRC  &kp DEL
                &none    &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp LEFT     &kp DOWN     &kp UP       &kp RIGHT &none     &none
                &rgb_ug RGB_TOG &rgb_ug RGB_HUD &rgb_ug RGB_HUI &rgb_ug RGB_BRD &rgb_ug RGB_BRI &rgb_ug RGB_EFF   &none  &kp PG_DN  &kp PG_UP  &none  &none  &none
                                   &trans     &none       &trans                      &trans       &trans       &kp LGUI
            >;
        };

        num_layer {
            display-name = "NUM";
            bindings = <
                &kp GRAVE  &kp EXCL   &kp AT    &kp HASH  &kp DLLR   &kp PRCNT      &kp CARET &kp AMPS  &kp ASTRK &kp LPAR   &kp RPAR  &kp DEL
                &trans     &kp N1     &kp N2    &kp N3    &kp N4     &kp N5         &kp N6    &kp N7    &kp N8    &kp N9     &kp N0    &none
                &trans     &none      &none     &none     &kp EQUAL  &kp MINUS      &none     &none     &none     &none      &kp BSLH  &trans
                                      &trans    &trans     &trans                    &trans    &none     &kp LGUI
            >;
        };

        extra_1 {
            status = "reserved";
        };

        extra_2 {
            status = "reserved";
        };

        extra_3 {
            status = "reserved";
        };
    };
};
